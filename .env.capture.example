# Isolated Supabase project used ONLY for capturing screenshots and video.
#
# This must NEVER point at production. Production cannot be captured safely:
# `invoices`, `services`, insurance submissions and `leads` are not covered by
# the demo RLS policies, and the patient page plus 127 API routes render via the
# service-role key, which bypasses RLS entirely.
#
# Copy to .env.capture (gitignored) and fill in.

CAPTURE_SUPABASE_URL=https://your-capture-project.supabase.co
CAPTURE_SUPABASE_ANON_KEY=
CAPTURE_SUPABASE_SERVICE_ROLE_KEY=

# Required to apply DDL. Neither the anon nor the service_role key can run DDL —
# PostgREST is a data plane only. Supply ONE of the following:
#
#   Supabase dashboard → Project Settings → Database → Connection string → URI
CAPTURE_DB_URL=
#   ...or a personal access token: Supabase dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=

# Login used by the capture browser. Exists only on the isolated project.
CAPTURE_USER_EMAIL=capture@aliice.local
CAPTURE_USER_PASSWORD=

# The dev server the capture run drives, started with the capture env.
CAPTURE_APP_URL=http://localhost:3100
