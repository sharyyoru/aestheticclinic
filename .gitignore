# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.capture.example

# academy capture pipeline
# prod-spec.json is a full schema dump; the numbered parts are derived from
# schema.generated.sql (which is committed); out/ holds large intermediate media
scripts/academy/generated/prod-spec.json
scripts/academy/generated/provision-all.sql
scripts/academy/generated/0*.sql
scripts/academy/out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# whatsapp-web.js session data
.wwebjs_auth/
.wwebjs_cache/

# sumex documentation
sumex_docs/
*.chm

#webstorm settings
.idea
public/forms/Consentement anesthésie - Aesthetics (2).pdf
public/forms/CONSENTEMENT ÉCLAIRÉ.docx
public/forms/EN - Consentement anesthésie (1).pdf
public/forms/EN - Questionnaire d'anesthésie  (1).pdf
public/forms/FR - Questionnaire d'anesthésie.pdf

# Deployment-only excludes: separate mobile apps and tooling not part of the Next.js web build
/mobile-app
/mobile-app-patient
/whatsapp-server
/server
# scripts/* stays excluded, except the committed Academy capture pipeline
/scripts/*
!/scripts/academy/
!/scripts/tsconfig.json
/docs
/*.md
